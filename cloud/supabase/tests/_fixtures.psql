-- The fixtures (RLS pgTAP plan, D5): two accounts, A and B, and their rows. Every pgTAP file that
-- probes rows includes it after `_setup.psql` and `_matrix.psql`, inside the file's own
-- transaction, so all of it rolls back with the file. pg_prove does not run it as a test.
--
-- No real data: random UUIDs, `@example.invalid` addresses and placeholder text. No id is printed.
-- Runs as the database owner the CLI connects as.

-- A and B, made the way sign-up makes them: an `auth.users` insert alone, with the column list and
-- the values `proofs/testers_staging.sql` uses, so the row looks like a real sign-up's. The token
-- and change columns are '' as the proof writes them, not null (GoTrue cannot read a user whose
-- token column is null); '' is also outside the tokens' partial unique indexes, so A and B never
-- collide there. Like the proof, it leaves out `confirmed_at` (generated), the password hash and
-- `recovery_sent_at`. The triggers do the rest: `on_auth_user_metadata` trims the metadata, and
-- `on_auth_user_created` (`handle_new_user`, which reads no metadata since 20260917000100) writes
-- the `accounts` row and the `entitlements` row at `none`. The owner's insert fires both. A
-- trigger runs without an EXECUTE check, so 20261109000100's revoke from the client roles does
-- not touch it.
insert into tests.accounts (who, id) values ('A', gen_random_uuid()), ('B', gen_random_uuid());

insert into auth.users (instance_id, id, aud, role, email, email_confirmed_at, last_sign_in_at,
                        raw_app_meta_data, raw_user_meta_data, created_at, updated_at,
                        confirmation_token, recovery_token, email_change_token_new, email_change,
                        email_change_token_current, email_change_confirm_status, phone_change,
                        phone_change_token, reauthentication_token, is_anonymous, is_sso_user)
select '00000000-0000-0000-0000-000000000000', a.id, 'authenticated', 'authenticated',
       format('rls-%s@example.invalid', lower(a.who)), now(), now(),
       '{"provider": "email", "providers": ["email"]}', '{}', now(), now(),
       '', '', '', '', '', 0, '', '', '', false, false
  from tests.accounts a
 order by a.who;

-- V1: both accounts hold an active subscription, so `billing_subscribers` has one row for each.
update public.entitlements e
   set status = 'active', stripe_subscription_id = 'sub_rls_fixture_' || lower(a.who)
  from tests.accounts a
 where e.account_id = a.id;

-- One row for A and one for B in each other owner-read table, through `tests.insert_sql`: the
-- same text every insert probe uses, so the fixture rows also prove those inserts valid as the
-- owner. `sync_usage` is left out: the `sync_records` and `sync_notes` inserts make its row through
-- `sync_usage_bump`. `sync_notes` rows are live notes (`deleted = false`, a short body), which
-- the sentinel update on `body` (the matrix's `touch_col`) needs.
do $$
declare r record;
begin
  for r in
    select m.rel, a.who
      from tests.matrix m
     cross join tests.accounts a
     where m.access = 'own'
       and m.rel not in ('public.accounts', 'public.entitlements', 'public.sync_usage')
     order by m.rel, a.who
  loop
    execute tests.insert_sql(r.rel, r.who);
  end loop;
end $$;

-- The service-only tables (T5c), through the same `tests.insert_sql` text: one row for A and one
-- for B in each table with an account key, and the one row of each global table. `models` is not
-- written: its insert reuses the seeded `task` pin, so the seeded row is its fixture. Chains
-- follow their foreign keys, so the six tables that need a parent go last: `rule_evidence` (A's
-- rule and A's judgment) and the five that reference `mail_addresses`.
do $$
declare r record;
begin
  for r in
    select m.rel, a.who
      from tests.matrix m
     cross join tests.accounts a
     where m.access = 'service' and m.rel <> 'public.models'
       and (m.key_col is not null or a.who = 'A')
     order by m.rel in ('public.rule_evidence', 'public.mail_batches', 'public.mail_canaries',
                        'public.mail_seen', 'public.mail_work', 'public.mail_claims'),
              m.rel, a.who
  loop
    execute tests.insert_sql(r.rel, r.who);
  end loop;
end $$;
