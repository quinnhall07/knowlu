{
  "model": "claude-opus-5-5",
  "effortLevel": "medium",
  "maxEffortLevel": "xhigh",
  "env": {
    "CARGO_BUILD_JOBS": "2",
    "ENABLE_CODE_SECURITY_REVIEW": "0"
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(cargo build:*)",
      "Bash(cargo test:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo fmt:*)"
    ],
    "deny": [
      "Edit(**/engine/tests/fixtures/golden-today-s1.md)",
      "Write(**/engine/tests/fixtures/golden-today-s1.md)",
      "Edit(**/engine/tests/fixtures/golden-today-full.md)",
      "Write(**/engine/tests/fixtures/golden-today-full.md)",
      "Edit(**/engine/tests/fixtures/calendar-snapshot-gcal.md)",
      "Write(**/engine/tests/fixtures/calendar-snapshot-gcal.md)",
      "Edit(**/engine/tests/fixtures/vault-full/state/events.md)",
      "Write(**/engine/tests/fixtures/vault-full/state/events.md)",
      "Edit(**/engine/tests/fixtures/zybooks-parsed-reference.json)",
      "Write(**/engine/tests/fixtures/zybooks-parsed-reference.json)",
      "Edit(**/engine/tests/fixtures/vhl-parsed-reference.json)",
      "Write(**/engine/tests/fixtures/vhl-parsed-reference.json)",
      "Edit(**/engine/tests/fixtures/run-records-reference.json)",
      "Write(**/engine/tests/fixtures/run-records-reference.json)",
      "Edit(**/engine/tests/fixtures/pyyaml-safe-dump-reference.json)",
      "Write(**/engine/tests/fixtures/pyyaml-safe-dump-reference.json)",
      "Bash(cargo tauri build:*)",
      "Bash(cargo test --release:*)",
      "Bash(git stash:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin --force:*)",
      "Bash(git push origin -f:*)",
      "Bash(cargo test --workspace --release:*)"
    ],
    "ask": [
      "mcp__supabase-prod__*",
      "Bash(supabase:*)",
      "Bash(npx supabase:*)"
    ]
  },
  "subagentPromptCacheTtl": "1h",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/pretool-bash.js\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
