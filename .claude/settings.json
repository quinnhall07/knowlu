{
  "model": "claude-opus-5-5",
  "effortLevel": "medium",
  "maxEffortLevel": "xhigh",
  "env": {
    "CARGO_BUILD_JOBS": "2",
    "ENABLE_CODE_SECURITY_REVIEW": "0"
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(cargo build:*)",
      "Bash(cargo test:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo fmt:*)"
    ],
    "deny": [
      "Edit(engine/tests/fixtures/**)",
      "Write(engine/tests/fixtures/**)",
      "Edit(**/engine/tests/fixtures/**)",
      "Write(**/engine/tests/fixtures/**)",
      "Bash(cargo tauri build:*)",
      "Bash(cargo test --release:*)",
      "Bash(git stash:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin --force:*)",
      "Bash(git push origin -f:*)",
      "Bash(cargo test --workspace --release:*)"
    ]
  },
  "subagentPromptCacheTtl": "1h",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|PowerShell)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/pretool-bash.js\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
