# LF everywhere, on every platform. The one exception is PowerShell, which is happier as CRLF.
* text=auto eol=lf
*.ps1 text eol=crlf
# Frozen test fixtures are bytes. Several are golden files compared byte-for-byte, and users'
# vaults are CRLF on Windows, so these stay exactly as committed — never re-encoded.
engine/tests/fixtures/** -text
